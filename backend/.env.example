# 复制为 .env 后按本机情况修改(.env 含口令,已被 .gitignore 排除)
# MySQL:库不存在时先建库  CREATE DATABASE db_va DEFAULT CHARSET utf8mb4;
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/db_va?charset=utf8mb4

# 10 年期国债收益率(小数),用于格氏/巴菲特买入阈值折现
BOND_10Y=0.017

# 采集脚本的 JSON 工作目录根(其下含 data/ agro-price/)
# 指向仓库内 backend/collector 即可,本仓库自给自足
LEGACY_DATA_DIR=<项目目录>\backend\collector

# Wind MCP skill 目录(fetch_events / fetch_edb 通过 node 调用其 cli.mjs)
# 只有 edb / events 两个任务需要;不配则这两个 job 找不到 skill
WIND_SKILL_DIR=<wind-mcp-skill 目录>
